<launch>
  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
  </include>

  <group ns="panda1">
    <include file="$(find franka_gazebo)/launch/robot.launch">
      <arg name="gazebo" value="false" /> <arg name="robot" value="panda" />
      <arg name="arm_id" value="panda1" />
      <arg name="x" value="0" />
      <arg name="y" value="0" />
      <arg name="z" value="0" />
      <arg name="yaw" value="0" />
      <arg name="controller" value="effort_joint_trajectory_controller" />
    </include>

    <include file="$(find panda_moveit_config)/launch/move_group.launch">
      <arg name="arm_id" value="panda1" />
      <arg name="load_robot_description" value="false" /> 
    </include>
  </group>

  <group ns="panda2">
    <include file="$(find franka_gazebo)/launch/robot.launch">
      <arg name="gazebo" value="false" />
      <arg name="robot" value="panda" />
      <arg name="arm_id" value="panda2" />
      <arg name="x" value="1.128" /> <arg name="y" value="0" />
      <arg name="z" value="0" />
      <arg name="yaw" value="3.14159" /> <arg name="controller" value="effort_joint_trajectory_controller" />
    </include>

    <include file="$(find panda_moveit_config)/launch/move_group.launch">
      <arg name="arm_id" value="panda2" />
      <arg name="load_robot_description" value="false" />
    </include>
  </group>

</launch>
