<?xml version="1.0" ?>
<launch>
  <!-- 1. إعدادات الـ IPs للروبوتات الحقيقية -->
  <arg name="robot_ip_1" default="172.16.1.2" />
  <arg name="robot_ip_2" default="172.16.1.3" />

  <!-- 2. توحيد الـ Origin: تعريف مكان الروبوت الثاني بالنسبة للأول -->
  <!--args: x y z yaw pitch roll frame_id child_frame_id -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="dual_panda_origin_linker" 
        args="1.05 0 0 3.14159 0 0 panda1_link0 panda2_link0" />

  <!-- 3. إعداد الروبوت الأول (panda1) -->
  <group ns="panda1">
    <include file="$(find franka_control)/launch/franka_control.launch">
      <arg name="robot_ip" value="$(arg robot_ip_1)" />
      <arg name="arm_id"   value="panda1" />
      <arg name="load_gripper" value="true" />
    </include>

    <!-- تشغيل الكنترولر المسؤول عن تنفيذ المسارات (Trajectories) -->
    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" 
          args="effort_joint_trajectory_controller"/>

    <!-- تشغيل MoveGroup الخاص بالروبوت الأول لتخطيط الحركة -->
    <include file="$(find panda_moveit_config)/launch/move_group.launch">
      <arg name="arm_id" value="panda1" />
      <arg name="load_robot_description" value="false" /> 
    </include>
  </group>

  <!-- 4. إعداد الروبوت الثاني (panda2) -->
  <group ns="panda2">
    <include file="$(find franka_control)/launch/franka_control.launch">
      <arg name="robot_ip" value="$(arg robot_ip_2)" />
      <arg name="arm_id"   value="panda2" />
      <arg name="load_gripper" value="true" />
    </include>

    <node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" 
          args="effort_joint_trajectory_controller"/>

    <include file="$(find panda_moveit_config)/launch/move_group.launch">
      <arg name="arm_id" value="panda2" />
      <arg name="load_robot_description" value="false" />
    </include>
  </group>

</launch>
